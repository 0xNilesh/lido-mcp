{
  "name": "lido-mcp",
  "version": "0.1.0",
  "description": "MCP server for Lido liquid staking — stake, unstake, wrap, governance, all from AI agents",
  "type": "module",
  "bin": {
    "lido-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "files": [
    "dist",
    "lido.skill.md"
  ],
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "@lidofinance/lido-ethereum-sdk": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "viem": "^2.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
