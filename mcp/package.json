{
  "name": "lido-mcp",
  "version": "0.1.1",
  "description": "A MCP server that provides Claude AI and other MCP-compatible agents with real-time access to Lido liquid staking on Ethereum — stake, unstake, wrap, govern, and manage staking positions directly from a conversation.",
  "type": "module",
  "author": "Nilesh Gupta",
  "license": "MIT",
  "keywords": [
    "lido",
    "mcp",
    "steth",
    "wsteth",
    "staking",
    "ethereum",
    "liquid-staking",
    "model-context-protocol",
    "ai-agent",
    "claude",
    "defi",
    "governance",
    "stvaults"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0xnilesh/lido-mcp"
  },
  "bin": {
    "lido-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "files": [
    "dist",
    "lido.skill.md"
  ],
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "@lidofinance/lido-ethereum-sdk": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "viem": "^2.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
